# Ignore everything by default — we opt-in via explicit `dot add`
*

# ...but allow these dotfiles/config subdirectories to be explored
!.config/
!.config/.gitignore
!.config/install.sh
!.config/README.md
!.zshrc
!.bashrc

# Inside allowed dirs, still exclude secrets & caches
.config/**/cache/
.config/**/secrets/
.config/**/*.key
.config/**/*.pem
.ssh/
.gnupg/
.aws/
.local/share/
